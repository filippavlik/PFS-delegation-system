@using AdminPartDevelop
@using AdminPartDevelop.Models
@using AdminPartDevelop.Views.ViewModels
@using System.Globalization
@model RefereeCardViewModel


@{
    ViewData["Title"] = "Karta rozhodčího";
}
@{
    var referee = Model.RefereeWTimeOptions.Referee;
}
<style>
    /* Base styles for all events */
    .event {
    position: absolute;
    height: 75%;
    top: 12.5%;
    border-radius: 4px;
    padding: 3px 6px;
    box-sizing: border-box;
    font-size: 0.85em;
    overflow: hidden;
    transition: all 0.2s ease;
    z-index: 0; /* Default base */
    }

    /* Hover or simulated hover */
    .event:hover,
    .event.hover-simulated {
    height: 85%;
    top: 7.5%;
    z-index: 100; /* Bring to front temporarily */
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
    transform: scale(1.05); /* Optional: smooth grow effect */
    }

    /* Styles for match events ("zapas") */
    .zapasref {
    background-color: #ff7675;
    border: 1px solid #d63031;
    color: #2d3436;
    z-index: 30;
    }

    .zapasar {
    background-color: #55efc4;
    border: 1px solid #00b894;
    color: #2d3436;
    z-index: 30;
    }

    .zapasar:hover {
    background-color: #a3f7e0;
    border-color: #66d5b4;
    }

    .zapasref:hover {
    background-color: #fab1a0;
    }

    /* Styles for excuse events ("omluva") */
    .omluva {
    background-color: #ffeaa7;
    border: 1px solid #fdcb6e;
    color: #2d3436;
    z-index: 20;
    }

    .omluva:hover {
    background-color: #ffeaa7;
    }

    /* Styles for vehicle events ("vozidlo") with less opacity */
    .vozidlocar,
    vozidlobus {
    background-color: #74b9ff;
    border: 1px solid #0984e3;
    color: #2d3436;
    z-index: 5;
    }

    .vozidlocar:hover,
    .vozidlobus:hover {
    background-color: rgba(116, 185, 255, 0.8);
    }

    .transferhome {
    background-color: #ff33fb;
    border: 1px solid #940096;
    color: #2d3436;
    z-index: 10;
    }

    .transferhome:hover {
    background-color: #ff33fb7a;
    }

    /* Unique colors for transfermatch */
    .transfermatch {
    background-color: #ff9f43; /* orange */
    border: 1px solid #ff6f00;
    color: #2d3436;
    z-index: 10;
    }

    .transfermatch:hover,
    .transfermatch.hover-simulated {
    background-color: #ffc66d; /* lighter orange on hover */
    }

    .actualllocation {
    background-color: #ced4da; /* grey */
    border: 1px solid #6c757d;
    color: #2d3436;
    z-index: 5;
    }

    .actualllocation:hover,
    .actualllocation.hover-simulated {
    background-color: #e9ecef; /* lighter orange on hover */
    }



    /* Apply same color changes as your :hover states */
    .zapasref.hover-simulated {
    background-color: #fab1a0;
    }

    .zapasar.hover-simulated {
    background-color: #a3f7e0;
    border-color: #66d5b4;
    }

    .omluva.hover-simulated {
    background-color: #ffeaa7;
    }

    .vozidlocar.hover-simulated,
    .vozidlobus.hover-simulated {
    background-color: rgba(116, 185, 255, 0.8);
    }

    .transferhome.hover-simulated {
    background-color: #ff33fb7a;
    }

    .transfermatch.hover-simulated {
    background-color: #ffc66d; /* lighter orange on hover */
    }

    /* Styles for the event contents */
    .event-title {
    font-weight: bold;
    white-space: normal; /* allow line breaks */
    overflow: hidden;
    text-overflow: ellipsis;
    }

    /* Custom styles for the schedule */
    .schedule-container {
    max-width: 100%;
    position: relative;
    }

    .time-header, .day-row {
    display: flex;
    height: 50px;
    max-width: 100%;
    }

    .list-group-excuses {
    max-height: 250px; /* This constrains the overall height */
    overflow-y: auto; /* Enables vertical scrolling */
    overflow-x: hidden; /* Prevents horizontal scrolling */
    padding: 0; /* Removes default padding */
    margin: 0; /* Removes default margin */
    }

    .list-group-excuses-item {
    padding: 10px 15px;
    border-bottom: 1px solid #ddd;
    }

    .list-group-excuses-item:last-child {
    border-bottom: none;
    }

    .time-header {
    border-bottom: 1px solid #ddd;
    background-color: #f8f9fa;
    position: sticky;
    top: 0;
    z-index: 10;
    }

    .day-label {
    width: 120px;
    min-width: 120px;
    height:50px;
    padding: 5px;
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f8f9fa;
    border-right: 1px solid #ddd;
    }

    .time-slot {
    width: 60px;
    min-width: 60px;
    text-align: center;
    padding: 5px 0;
    border-right: 1px dashed #ddd;
    font-size: 0.8rem;
    }

    .day-timeline {
    flex: 1;
    position: relative;
    min-width: 900px; /* 17 hours * 80px */
    border-bottom: 1px solid #ddd;
    height:50px;
    }

    .day-timeline::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: repeating-linear-gradient( to right, transparent, transparent calc(100% / 16 - 1px), #ddd calc(100% / 16 - 1px), #ddd calc(100% / 16) );
    pointer-events: none;
    z-index: 1;
    }

    .event {
    position: absolute;
    height: 40px;
    top: 10px;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 0.85rem;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: white;
    cursor: pointer;
    }

    .match-event {
    background-color: #007bff;
    }

    .excuse-event {
    background-color: #dc3545;
    }

    .transfer-event {
    background-color: #6c757d;
    }

    .initials {
    font-size: 50px;
    color: white;
    font-weight: bold;
    }

    /* Custom Context Menu Styles */
    .custom-context-menu {
    position: absolute;
    background-color: white;
    border: 1px solid #ddd;
    border-radius: 4px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    z-index: 1000;
    }

    .context-menu-items {
    list-style: none;
    padding: 0;
    margin: 0;
    }

    .context-menu-items li {
    padding: 8px 12px;
    cursor: pointer;
    }

    .context-menu-items li:hover {
    background-color: #f5f5f5;
    }

    .overlay-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 999;
    }

    #cardForm {
    display: flex;
    flex-direction: column;
    gap: 15px;
    }


    .flatpickr-wrapper {
    display: flex;
    align-items: center;
    border: 1px solid #ddd;
    border-radius: 4px;
    padding: 8px 10px;
    background-color: #f9f9f9;
    margin-bottom: 10px;
    }

    .flatpickr-wrapper input {
    flex: 1;
    border: none;
    padding: 8px;
    background: transparent;
    font-size: 16px;
    outline: none;
    }


    .excuses-list-container {
    margin-top: 15px;
    }

    #excusesList {
    list-style: none;
    padding: 0;
    margin: 0;
    }

    #excusesList li {
    background-color: #f5f5f5;
    border-radius: 4px;
    padding: 12px;
    margin-bottom: 8px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    }


    .excuse-info {
    flex: 1;
    }

    .excuse-time {
    font-weight: bold;
    }

    .excuse-reason {
    color: #555;
    margin-top: 5px;
    }

    .delete-excuse {
    color: #ea4335;
    cursor: pointer;
    padding: 5px;
    font-size: 1.2rem;
    }

    #noExcusesMessage {
    text-align: center;
    color: #777;
    font-style: italic;
    padding: 15px;
    }

    .slot-info {
    flex: 1;
    }

    .slot-time {
    font-weight: bold;
    }

    .delete-slot {
    color: #ea4335;
    cursor: pointer;
    padding: 5px;
    font-size: 1.2rem;
    }

    .competitions-container {
    margin-top: 20px;
    }

